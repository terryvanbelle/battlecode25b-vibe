 NoDataToDisplay(Highcharts);
 
+// Replica only: the project's milestones (progress/milestones.csv, installed as /milestones.json by
+// `galaxy-setup.sh milestones`), drawn on every rating chart beside the tournament lines. A missing or malformed
+// file (the SPA fallback answers with index.html) draws nothing.
+interface Milestone {
+  tag: string;
+  label: string;
+  t: number;
+}
+let milestonesOnce: Promise<Milestone[]> | undefined = undefined;
+const isMilestone = (x: unknown): x is Milestone => {
+  if (typeof x !== "object" || x === null) return false;
+  const o = x as Record<string, unknown>;
+  return (
+    typeof o.t === "number" &&
+    typeof o.tag === "string" &&
+    typeof o.label === "string"
+  );
+};
+const loadMilestones = async (): Promise<Milestone[]> => {
+  milestonesOnce ??= fetch("/milestones.json", { cache: "no-cache" })
+    .then(async (r) => (r.ok ? ((await r.json()) as unknown) : []))
+    .then((m) => (Array.isArray(m) ? m.filter(isMilestone) : []))
+    .catch(() => []);
+  return await milestonesOnce;
+};
+
 export interface ChartBaseProps {
   yAxisLabel: string;
   values?: Record<string, ChartData[]>;
